### 2. `HumanoidAnimeMesh.kt` (Geometria Articulada Anime + Cabelo + Chapéu + Cachecol + Arma)

Gera malhas separadas por parte (`HEAD`, `TORSO`, `LEFT_ARM`, `RIGHT_ARM`, `LEFT_LEG`, `RIGHT_LEG`, `BACK_CLOTH`, `WEAPON`), já com **normais suavizadas via `SmoothNormalBaker`** e **UV mapeado exatamente nos quadrantes do `AnimeTextureAtlas`**.

```kotlin
package com.cacadores.sertao.render

import android.opengl.GLES20
import java.nio.ByteBuffer
import java.nio.ByteOrder
import kotlin.math.cos
import kotlin.math.sin

class HumanoidAnimeMesh(val profile: CharacterVisualProfile) {

    enum class BodyPart { HEAD, TORSO, LEFT_ARM, RIGHT_ARM, LEFT_LEG, RIGHT_LEG, BACK_CLOTH, WEAPON }

    data class PartGpuBuffers(
        val vboId: Int,
        val iboId: Int,
        val indexCount: Int,
        val tintColor: FloatArray,
        val useTexture: Float,
        val emissive: Float
    )

    companion object {
        // pos(3) + norm(3) + uv(2) + color(3) + smoothNorm(3) = 14 floats (56 bytes)
        const val FLOATS_PER_VERTEX = 14
        const val STRIDE_BYTES = FLOATS_PER_VERTEX * 4
    }

    val parts = HashMap<BodyPart, PartGpuBuffers>()

    fun buildAndUpload() {
        release()
        buildHead()
        buildTorso()
        buildArm(isLeft = true)
        buildArm(isLeft = false)
        buildLeg(isLeft = true)
        buildLeg(isLeft = false)
        buildBackCloth()
        buildWeapon()
    }

    private fun buildHead() {
        val m = MeshAssembler()
        // Cabeca oval estilizada + plano frontal de olhos mapeado no quadrante 1 ou 2 do Atlas
        m.addEllipsoid(0f, 0.16f, 0f, 0.155f, 0.185f, 0.165f, 12, 10, profile.skinColor, 0.72f, 0.25f)
        // Plano frontal de rosto/olhos (UV exata no Atlas)
        val u0 = if (profile.useDemonEyes) 0.50f else 0.0f // 0..0.25 heroi, 0.25..0.50 demonio
        val eyeUStart = if (profile.useDemonEyes) 0.26f else 0.01f
        val eyeUEnd = if (profile.useDemonEyes) 0.49f else 0.24f
        m.addCurvedFaceQuad(0f, 0.17f, 0.166f, 0.22f, 0.13f, eyeUStart, 0.08f, eyeUEnd, 0.36f, floatArrayOf(1f, 1f, 1f))

        // Cabelo anime em pontas (franja + nuca + laterais)
        for (i in 0 until 8) {
            val angle = (i / 8f) * 6.2831f
            val hx = sin(angle) * 0.13f
            val hz = cos(angle) * 0.13f
            val tiltOut = if (hz > 0.05f) 0.06f else 0.10f // Franja mais curta, nuca mais longa
            m.addCone(hx, 0.24f, hz, 0.075f, 0.22f, hx * tiltOut * 6f, -0.15f, hz * tiltOut * 6f, profile.hairColor)
        }
        // Touca base do cabelo
        m.addEllipsoid(0f, 0.22f, -0.02f, 0.168f, 0.145f, 0.175f, 10, 8, profile.hairColor, 0.75f, 0.22f)

        // Barba pontuda (Mestre Severino / Mercador)
        if (profile.hasBeard) {
            m.addCone(0f, 0.05f, 0.14f, 0.085f, 0.18f, 0f, -0.22f, 0.04f, profile.hairColor)
        }

        // Chapeus / Chifres / Bandana
        when (profile.hatStyle) {
            HatStyle.BROKEN_BRIM, HatStyle.WIDE_BRIM, HatStyle.STRAW_HAT, HatStyle.ECLIPSE_HAT -> {
                val brimRadius = when (profile.hatStyle) {
                    HatStyle.WIDE_BRIM, HatStyle.STRAW_HAT -> 0.40f
                    HatStyle.ECLIPSE_HAT -> 0.35f
                    else -> 0.31f
                }
                // Aba do chapeu
                m.addTaperedCylinder(0f, 0.31f, 0f, brimRadius * 0.92f, brimRadius, 0.028f, 14, profile.hatColor, 0.75f, 0.25f)
                // Copa do chapeu
                m.addTaperedCylinder(0f, 0.32f, 0f, 0.155f, 0.185f, 0.14f, 12, profile.hatColor, 0.75f, 0.25f)
                // Aba dianteira quebrada para cima (estilo vaqueiro/heroi)
                if (profile.hatStyle == HatStyle.BROKEN_BRIM) {
                    m.addBox(0f, 0.36f, 0.22f, 0.18f, 0.08f, 0.03f, profile.hatColor)
                    // Broche dourado da Ordem
                    m.addBox(0f, 0.37f, 0.185f, 0.05f, 0.05f, 0.02f, floatArrayOf(0.98f, 0.80f, 0.20f, 1f))
                }
            }
            HatStyle.BANDANA -> {
                m.addTaperedCylinder(0f, 0.26f, 0f, 0.172f, 0.172f, 0.07f, 12, profile.hatColor, 0.75f, 0.25f)
            }
            HatStyle.HORNS -> {
                m.addCone(-0.10f, 0.32f, 0.02f, 0.04f, 0.22f, -0.10f, 0.20f, 0.05f, profile.hatColor)
                m.addCone(0.10f, 0.32f, 0.02f, 0.04f, 0.22f, 0.10f, 0.20f, 0.05f, profile.hatColor)
            }
            HatStyle.NONE -> {}
        }

        val eyeGlow = if (profile.useDemonEyes) profile.emissiveStrength else 0f
        parts[BodyPart.HEAD] = m.uploadToGpu(floatArrayOf(1f, 1f, 1f, 1f), 1.0f, eyeGlow)
    }

    private fun buildTorso() {
        val m = MeshAssembler()
        val sw = profile.shoulderWidthScale
        // Tronco em "V" (ombros mais largos que a cintura)
        m.addTaperedCylinder(0f, 0.02f, 0f, 0.23f * sw, 0.15f, 0.52f, 10, profile.shirtColor, 0.72f, 0.25f)
        // Cinturao de couro com fivela
        m.addTaperedCylinder(0f, 0.01f, 0f, 0.162f, 0.162f, 0.09f, 10, profile.hatColor, 0.72f, 0.25f)
        m.addBox(0f, 0.04f, 0.165f, 0.08f, 0.06f, 0.03f, floatArrayOf(0.95f, 0.75f, 0.22f, 1f))
        // Bainha diagonal nas costas
        if (profile.weaponStyle != WeaponStyle.NONE) {
            m.addTaperedCylinder(-0.04f, 0.10f, -0.17f, 0.025f, 0.025f, 0.65f, 6, floatArrayOf(0.18f, 0.12f, 0.10f, 1f), 0.72f, 0.25f)
        }
        parts[BodyPart.TORSO] = m.uploadToGpu(floatArrayOf(1f, 1f, 1f, 1f), 1.0f, 0f)
    }

    private fun buildArm(isLeft: Boolean) {
        val m = MeshAssembler()
        val len = profile.armLengthScale
        // Ombro arredondado
        m.addEllipsoid(0f, -0.02f, 0f, 0.075f, 0.075f, 0.075f, 8, 6, profile.shirtColor, 0.72f, 0.25f)
        // Braco superior
        m.addTaperedCylinder(0f, -0.26f * len, 0f, 0.065f, 0.052f, 0.25f * len, 8, profile.shirtColor, 0.72f, 0.25f)
        // Antebraco + faixa de pulso
        m.addTaperedCylinder(0f, -0.50f * len, 0f, 0.052f, 0.042f, 0.24f * len, 8, profile.skinColor, 0.72f, 0.25f)
        // Punho fechado
        m.addEllipsoid(0f, -0.55f * len, 0.01f, 0.048f, 0.055f, 0.052f, 8, 6, profile.skinColor, 0.72f, 0.25f)
        val part = if (isLeft) BodyPart.LEFT_ARM else BodyPart.RIGHT_ARM
        parts[part] = m.uploadToGpu(floatArrayOf(1f, 1f, 1f, 1f), 0.0f, 0f)
    }

    private fun buildLeg(isLeft: Boolean) {
        val m = MeshAssembler()
        // Coxa afilando para o joelho
        m.addTaperedCylinder(0f, -0.34f, 0f, 0.088f, 0.068f, 0.36f, 8, profile.pantsColor, 0.72f, 0.25f)
        // Canela / Bota de cano medio
        m.addTaperedCylinder(0f, -0.70f, 0f, 0.072f, 0.055f, 0.36f, 8, profile.hatColor, 0.72f, 0.25f)
        // Pe / Bota apontando para frente (+Z)
        m.addBox(0f, -0.73f, 0.05f, 0.105f, 0.075f, 0.20f, profile.hatColor)
        val part = if (isLeft) BodyPart.LEFT_LEG else BodyPart.RIGHT_LEG
        parts[part] = m.uploadToGpu(floatArrayOf(1f, 1f, 1f, 1f), 0.0f, 0f)
    }

    private fun buildBackCloth() {
        if (profile.backStyle == BackStyle.NONE) return
        val m = MeshAssembler()
        when (profile.backStyle) {
            BackStyle.FLOWING_SCARF -> {
                // Anel no pescoco + duas pontas esvoacando atras (-Z)
                m.addTaperedCylinder(0f, 0.0f, 0f, 0.14f, 0.15f, 0.09f, 10, profile.accentColor, 0.72f, 0.25f)
                m.addBox(-0.04f, -0.22f, -0.24f, 0.11f, 0.48f, 0.025f, profile.accentColor)
                m.addBox(0.05f, -0.18f, -0.21f, 0.09f, 0.40f, 0.025f, profile.accentColor)
            }
            BackStyle.PONCHO, BackStyle.HIGH_COLLAR_CAPE, BackStyle.RAGGED_CAPE, BackStyle.RAGGED_WINGS -> {
                // Capa/Poncho largo caindo dos ombros
                m.addBox(0f, -0.36f, -0.18f, 0.44f, 0.78f, 0.04f, profile.accentColor)
                if (profile.backStyle == BackStyle.HIGH_COLLAR_CAPE) {
                    m.addTaperedCylinder(0f, 0.04f, -0.02f, 0.19f, 0.16f, 0.14f, 10, profile.shirtColor, 0.72f, 0.25f)
                }
            }
            BackStyle.NONE -> {}
        }
        parts[BodyPart.BACK_CLOTH] = m.uploadToGpu(floatArrayOf(1f, 1f, 1f, 1f), 1.0f, 0f)
    }

    private fun buildWeapon() {
        if (profile.weaponStyle == WeaponStyle.NONE) return
        val m = MeshAssembler()
        val steel = floatArrayOf(0.84f, 0.88f, 0.94f, 1f)
        val darkSteel = floatArrayOf(0.18f, 0.14f, 0.26f, 1f)
        val gold = floatArrayOf(0.95f, 0.76f, 0.22f, 1f)

        when (profile.weaponStyle) {
            WeaponStyle.PEIXEIRA, WeaponStyle.DUAL_PEIXEIRA, WeaponStyle.SABRE, WeaponStyle.DARK_SABER -> {
                val bladeLen = if (profile.weaponStyle == WeaponStyle.SABRE || profile.weaponStyle == WeaponStyle.DARK_SABER) 0.92f else 0.65f
                val bladeColor = if (profile.weaponStyle == WeaponStyle.DARK_SABER) darkSteel else steel
                // Cabo e guarda
                m.addBox(0f, 0f, -0.06f, 0.032f, 0.036f, 0.22f, floatArrayOf(0.28f, 0.16f, 0.10f, 1f))
                m.addBox(0f, 0f, 0.06f, 0.11f, 0.03f, 0.025f, gold)
                // Lamina apontando para frente (+Z) na mao
                m.addBox(0f, 0f, 0.08f + bladeLen * 0.5f, 0.018f, 0.06f, bladeLen, bladeColor)
                // Fio brilhante quando tiver emissive
                if (profile.emissiveStrength > 0.1f) {
                    m.addBox(0f, -0.025f, 0.08f + bladeLen * 0.5f, 0.022f, 0.018f, bladeLen, profile.accentColor)
                }
            }
            WeaponStyle.GREATSWORD -> {
                m.addBox(0f, 0f, 0.06f, 0.16f, 0.04f, 0.03f, gold)
                m.addBox(0f, 0f, 0.68f, 0.03f, 0.12f, 1.18f, steel)
            }
            WeaponStyle.GEAR_ARM -> {
                // Roda dentada de ferro do Moedor de Ossos
                m.addTaperedCylinder(0f, -0.10f, 0.16f, 0.24f, 0.24f, 0.08f, 12, floatArrayOf(0.38f, 0.34f, 0.36f, 1f), 0.72f, 0.72f)
            }
            WeaponStyle.LANTERN -> {
                m.addBox(0f, -0.15f, 0.15f, 0.12f, 0.18f, 0.12f, profile.accentColor)
            }
            WeaponStyle.NONE -> {}
        }
        parts[BodyPart.WEAPON] = m.uploadToGpu(floatArrayOf(1f, 1f, 1f, 1f), 0.0f, profile.emissiveStrength)
    }

    fun release() {
        parts.values.forEach {
            GLES20.glDeleteBuffers(2, intArrayOf(it.vboId, it.iboId), 0)
        }
        parts.clear()
    }

    /**
     * Construtor interno com SmoothNormalBaker automatico
     */
    private class MeshAssembler {
        private val pos = ArrayList<Float>()
        private val norm = ArrayList<Float>()
        private val uv = ArrayList<Float>()
        private val col = ArrayList<Float>()
        private val idx = ArrayList<Short>()
        private var vCount = 0

        fun addVert(x: Float, y: Float, z: Float, nx: Float, ny: Float, nz: Float, u: Float, v: Float, c: FloatArray, shade: Float = 1f) {
            pos.add(x); pos.add(y); pos.add(z)
            norm.add(nx); norm.add(ny); norm.add(nz)
            uv.add(u); uv.add(v)
            col.add(c[0] * shade); col.add(c[1] * shade); col.add(c[2] * shade)
            vCount++
        }

        fun addTri(a: Int, b: Int, c: Int) {
            idx.add(a.toShort()); idx.add(b.toShort()); idx.add(c.toShort())
        }

        fun addBox(cx: Float, cy: Float, cz: Float, sx: Float, sy: Float, sz: Float, c: FloatArray) {
            val hx = sx * 0.5f; val hy = sy * 0.5f; val hz = sz * 0.5f
            val faces = arrayOf(
                floatArrayOf(0f, 0f, 1f, -hx, -hy, hz, hx, -hy, hz, hx, hy, hz, -hx, hy, hz),
                floatArrayOf(0f, 0f, -1f, hx, -hy, -hz, -hx, -hy, -hz, -hx, hy, -hz, hx, hy, -hz),
                floatArrayOf(1f, 0f, 0f, hx, -hy, hz, hx, -hy, -hz, hx, hy, -hz, hx, hy, hz),
                floatArrayOf(-1f, 0f, 0f, -hx, -hy, -hz, -hx, -hy, hz, -hx, hy, hz, -hx, hy, -hz),
                floatArrayOf(0f, 1f, 0f, -hx, hy, hz, hx, hy, hz, hx, hy, -hz, -hx, hy, -hz),
                floatArrayOf(0f, -1f, 0f, -hx, -hy, -hz, hx, -hy, -hz, hx, -hy, hz, -hx, -hy, hz)
            )
            for (f in faces) {
                val base = vCount
                val shade = if (f[1] < -0.5f) 0.72f else 1.0f
                addVert(cx + f[3], cy + f[4], cz + f[5], f[0], f[1], f[2], 0.55f, 0.45f, c, shade)
                addVert(cx + f[6], cy + f[7], cz + f[8], f[0], f[1], f[2], 0.95f, 0.45f, c, shade)
                addVert(cx + f[9], cy + f[10], cz + f[11], f[0], f[1], f[2], 0.95f, 0.05f, c, shade)
                addVert(cx + f[12], cy + f[13], cz + f[14], f[0], f[1], f[2], 0.55f, 0.05f, c, shade)
                addTri(base, base + 1, base + 2)
                addTri(base, base + 2, base + 3)
            }
        }

        fun addTaperedCylinder(cx: Float, cy: Float, cz: Float, topR: Float, botR: Float, h: Float, segs: Int, c: FloatArray, u: Float, v: Float) {
            val baseStart = vCount
            for (i in 0..segs) {
                val a = (i.toFloat() / segs) * 6.28318f
                val ca = cos(a); val sa = sin(a)
                addVert(cx + ca * botR, cy, cz + sa * botR, ca, 0f, sa, u, v, c, 0.85f)
                addVert(cx + ca * topR, cy + h, cz + sa * topR, ca, 0f, sa, u + 0.2f, v + 0.15f, c, 1.0f)
            }
            for (i in 0 until segs) {
                val p0 = baseStart + i * 2
                addTri(p0, p0 + 1, p0 + 3)
                addTri(p0, p0 + 3, p0 + 2)
            }
        }

        fun addCone(cx: Float, cy: Float, cz: Float, r: Float, h: Float, tx: Float, ty: Float, tz: Float, c: FloatArray) {
            val segs = 6
            val tipIdx = vCount
            addVert(cx + tx, cy + h + ty, cz + tz, 0f, 1f, 0f, 0.72f, 0.25f, c, 1.05f)
            val ringStart = vCount
            for (i in 0..segs) {
                val a = (i.toFloat() / segs) * 6.28318f
                val ca = cos(a); val sa = sin(a)
                addVert(cx + ca * r, cy, cz + sa * r, ca, 0.2f, sa, 0.72f, 0.25f, c, 0.82f)
            }
            for (i in 0 until segs) {
                addTri(tipIdx, ringStart + i, ringStart + i + 1)
            }
        }

        fun addEllipsoid(cx: Float, cy: Float, cz: Float, rx: Float, ry: Float, rz: Float, slices: Int, stacks: Int, c: FloatArray, u: Float, v: Float) {
            val start = vCount
            for (st in 0..stacks) {
                val phi = (st.toFloat() / stacks) * 3.14159f
                val sp = sin(phi); val cp = cos(phi)
                for (sl in 0..slices) {
                    val theta = (sl.toFloat() / slices) * 6.28318f
                    val nx = sp * cos(theta); val ny = cp; val nz = sp * sin(theta)
                    addVert(cx + nx * rx, cy + ny * ry, cz + nz * rz, nx, ny, nz, u, v, c, if (ny < -0.3f) 0.85f else 1f)
                }
            }
            val row = slices + 1
            for (st in 0 until stacks) {
                for (sl in 0 until slices) {
                    val a = start + st * row + sl
                    val b = a + row
                    addTri(a, b, a + 1)
                    addTri(b, b + 1, a + 1)
                }
            }
        }

        fun addCurvedFaceQuad(cx: Float, cy: Float, cz: Float, w: Float, h: Float, u0: Float, v0: Float, u1: Float, v1: Float, c: FloatArray) {
            val base = vCount
            val hw = w * 0.5f; val hh = h * 0.5f
            addVert(cx - hw, cy - hh, cz - 0.015f, -0.25f, 0f, 0.96f, u0, v1, c)
            addVert(cx + hw, cy - hh, cz - 0.015f, 0.25f, 0f, 0.96f, u1, v1, c)
            addVert(cx + hw, cy + hh, cz - 0.015f, 0.25f, 0f, 0.96f, u1, v0, c)
            addVert(cx - hw, cy + hh, cz - 0.015f, -0.25f, 0f, 0.96f, u0, v0, c)
            addTri(base, base + 1, base + 2)
            addTri(base, base + 2, base + 3)
        }

        fun uploadToGpu(tint: FloatArray, useTex: Float, emissive: Float): PartGpuBuffers {
            val posArr = pos.toFloatArray()
            val normArr = norm.toFloatArray()
            val smoothArr = SmoothNormalBaker.bake(posArr, normArr)

            val interleaved = FloatArray(vCount * FLOATS_PER_VERTEX)
            for (i in 0 until vCount) {
                val o = i * FLOATS_PER_VERTEX
                interleaved[o + 0] = posArr[i * 3]
                interleaved[o + 1] = posArr[i * 3 + 1]
                interleaved[o + 2] = posArr[i * 3 + 2]
                interleaved[o + 3] = normArr[i * 3]
                interleaved[o + 4] = normArr[i * 3 + 1]
                interleaved[o + 5] = normArr[i * 3 + 2]
                interleaved[o + 6] = uv[i * 2]
                interleaved[o + 7] = uv[i * 2 + 1]
                interleaved[o + 8] = col[i * 3]
                interleaved[o + 9] = col[i * 3 + 1]
                interleaved[o + 10] = col[i * 3 + 2]
                interleaved[o + 11] = smoothArr[i * 3]
                interleaved[o + 12] = smoothArr[i * 3 + 1]
                interleaved[o + 13] = smoothArr[i * 3 + 2]
            }

            val vBuf = ByteBuffer.allocateDirect(interleaved.size * 4).order(ByteOrder.nativeOrder()).asFloatBuffer().apply {
                put(interleaved); position(0)
            }
            val iArr = idx.toShortArray()
            val iBuf = ByteBuffer.allocateDirect(iArr.size * 2).order(ByteOrder.nativeOrder()).asShortBuffer().apply {
                put(iArr); position(0)
            }

            val ids = IntArray(2)
            GLES20.glGenBuffers(2, ids, 0)
            GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, ids[0])
            GLES20.glBufferData(GLES20.GL_ARRAY_BUFFER, interleaved.size * 4, vBuf, GLES20.GL_STATIC_DRAW)
            GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, ids[1])
            GLES20.glBufferData(GLES20.GL_ELEMENT_ARRAY_BUFFER, iArr.size * 2, iBuf, GLES20.GL_STATIC_DRAW)
            GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, 0)
            GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, 0)

            return PartGpuBuffers(ids[0], ids[1], iArr.size, tint, useTex, emissive)
        }
    }
}
