### 3. `WorldSkyAndGroundRenderer.kt` (Céu, Nuvens, Serras, Chão Texturizado, Vila e Sombra no Solo)

Substitui o fundo laranja vazio por **cúpula de céu azul vibrante com nuvens, montanhas no horizonte, trilha texturizada da Vila das Almas (poço de pedra, casas e degraus) e disco de sombra escura embaixo de cada personagem**.

```kotlin
package com.cacadores.sertao.render

import android.graphics.*
import android.opengl.GLES20
import android.opengl.GLUtils
import java.nio.ByteBuffer
import java.nio.ByteOrder
import kotlin.math.cos
import kotlin.math.sin

class WorldSkyAndGroundRenderer {

    private var skyVbo = 0; private var skyIbo = 0; private var skyCount = 0
    private var groundVbo = 0; private var groundIbo = 0; private var groundCount = 0
    private var villageVbo = 0; private var villageIbo = 0; private var villageCount = 0
    private var shadowVbo = 0; private var shadowCount = 0
    private var groundTexId = 0

    fun init() {
        groundTexId = createGroundTexture512()
        buildSkyDomeAndSerras()
        buildGroundPlane()
        buildVilaDasAlmasStructures()
        buildShadowDisc()
    }

    fun drawSky(mvpMatrix: FloatArray, posLoc: Int, colLoc: Int, uMvpLoc: Int) {
        GLES20.glDepthMask(false)
        GLES20.glUniformMatrix4fv(uMvpLoc, 1, false, mvpMatrix, 0)
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, skyVbo)
        GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, skyIbo)
        GLES20.glEnableVertexAttribArray(posLoc)
        GLES20.glVertexAttribPointer(posLoc, 3, GLES20.GL_FLOAT, false, 24, 0)
        GLES20.glEnableVertexAttribArray(colLoc)
        GLES20.glVertexAttribPointer(colLoc, 3, GLES20.GL_FLOAT, false, 24, 12)
        GLES20.glDrawElements(GLES20.GL_TRIANGLES, skyCount, GLES20.GL_UNSIGNED_SHORT, 0)
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, 0)
        GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, 0)
        GLES20.glDepthMask(true)
    }

    fun drawGroundAndVillage(posLoc: Int, normLoc: Int, uvLoc: Int, colLoc: Int) {
        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, groundTexId)
        drawStridedBatch(groundVbo, groundIbo, groundCount, posLoc, normLoc, uvLoc, colLoc)
        drawStridedBatch(villageVbo, villageIbo, villageCount, posLoc, normLoc, uvLoc, colLoc)
    }

    fun drawContactShadow(posLoc: Int) {
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, shadowVbo)
        GLES20.glEnableVertexAttribArray(posLoc)
        GLES20.glVertexAttribPointer(posLoc, 3, GLES20.GL_FLOAT, false, 12, 0)
        GLES20.glDrawArrays(GLES20.GL_TRIANGLE_FAN, 0, shadowCount)
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, 0)
    }

    private fun drawStridedBatch(vbo: Int, ibo: Int, count: Int, posLoc: Int, normLoc: Int, uvLoc: Int, colLoc: Int) {
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, vbo)
        GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, ibo)
        GLES20.glEnableVertexAttribArray(posLoc)
        GLES20.glVertexAttribPointer(posLoc, 3, GLES20.GL_FLOAT, false, 44, 0)
        GLES20.glEnableVertexAttribArray(normLoc)
        GLES20.glVertexAttribPointer(normLoc, 3, GLES20.GL_FLOAT, false, 44, 12)
        GLES20.glEnableVertexAttribArray(uvLoc)
        GLES20.glVertexAttribPointer(uvLoc, 2, GLES20.GL_FLOAT, false, 44, 24)
        GLES20.glEnableVertexAttribArray(colLoc)
        GLES20.glVertexAttribPointer(colLoc, 3, GLES20.GL_FLOAT, false, 44, 32)
        GLES20.glDrawElements(GLES20.GL_TRIANGLES, count, GLES20.GL_UNSIGNED_SHORT, 0)
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, 0)
        GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, 0)
    }

    private fun createGroundTexture512(): Int {
        val bmp = Bitmap.createBitmap(512, 512, Bitmap.Config.ARGB_8888)
        val c = Canvas(bmp)
        // Base verde-oliva/grama vibrante do sertao (combina com trilha por VertexColor)
        c.drawColor(Color.rgb(162, 184, 108))
        val p = Paint(Paint.ANTI_ALIAS_FLAG)
        for (i in 0..220) {
            val x = ((i * 73) % 512).toFloat()
            val y = ((i * 137) % 512).toFloat()
            p.color = if (i % 2 == 0) Color.argb(45, 110, 145, 65) else Color.argb(40, 215, 190, 125)
            c.drawCircle(x, y, 8f + (i % 16), p)
        }
        val tex = IntArray(1)
        GLES20.glGenTextures(1, tex, 0)
        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, tex[0])
        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MIN_FILTER, GLES20.GL_LINEAR_MIPMAP_LINEAR)
        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MAG_FILTER, GLES20.GL_LINEAR)
        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_WRAP_S, GLES20.GL_REPEAT)
        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_WRAP_T, GLES20.GL_REPEAT)
        GLUtils.texImage2D(GLES20.GL_TEXTURE_2D, 0, bmp, 0)
        GLES20.glGenerateMipmap(GLES20.GL_TEXTURE_2D)
        bmp.recycle()
        return tex[0]
    }

    private fun buildSkyDomeAndSerras() {
        val verts = ArrayList<Float>()
        val idx = ArrayList<Short>()
        val stacks = 8; val slices = 18; val radius = 95f
        for (st in 0..stacks) {
            val t = st.toFloat() / stacks
            val phi = t * 1.57f
            val y = sin(phi) * radius - 4f
            val r = cos(phi) * radius
            // Gradiente de Ceu Azul Anime -> Horizonte Claro Dourado
            val cr = 0.72f * (1f - t) + 0.24f * t
            val cg = 0.86f * (1f - t) + 0.56f * t
            val cb = 0.96f * (1f - t) + 0.92f * t
            for (sl in 0..slices) {
                val a = (sl.toFloat() / slices) * 6.28318f
                verts.add(cos(a) * r); verts.add(y); verts.add(sin(a) * r)
                verts.add(cr); verts.add(cg); verts.add(cb)
            }
        }
        val row = slices + 1
        for (st in 0 until stacks) {
            for (sl in 0 until slices) {
                val a = st * row + sl; val b = a + row
                idx.add(a.toShort()); idx.add((a + 1).toShort()); idx.add(b.toShort())
                idx.add(b.toShort()); idx.add((a + 1).toShort()); idx.add((b + 1).toShort())
            }
        }
        // Anel de Serras distantes azuladas no horizonte
        val baseRingStart = verts.size / 6
        val mountainSlices = 24
        for (i in 0..mountainSlices) {
            val a = (i.toFloat() / mountainSlices) * 6.28318f
            val x = cos(a) * 82f; val z = sin(a) * 82f
            val peakH = 8f + (sin(i * 1.9f) * 0.5f + 0.5f) * 14f
            verts.add(x); verts.add(-2f); verts.add(z); verts.add(0.42f); verts.add(0.54f); verts.add(0.70f)
            verts.add(x); verts.add(peakH); verts.add(z); verts.add(0.56f); verts.add(0.70f); verts.add(0.84f)
        }
        for (i in 0 until mountainSlices) {
            val p = baseRingStart + i * 2
            idx.add(p.toShort()); idx.add((p + 2).toShort()); idx.add((p + 1).toShort())
            idx.add((p + 1).toShort()); idx.add((p + 2).toShort()); idx.add((p + 3).toShort())
        }

        val pair = uploadSimple(verts.toFloatArray(), idx.toShortArray())
        skyVbo = pair.first; skyIbo = pair.second; skyCount = idx.size
    }

    private fun buildGroundPlane() {
        // Malha subdividida 16x16 para pintar a trilha de terra batida no centro
        val grid = 16; val half = 48f
        val v = ArrayList<Float>(); val idx = ArrayList<Short>()
        for (z in 0..grid) {
            for (x in 0..grid) {
                val wx = -half + (x.toFloat() / grid) * (half * 2f)
                val wz = -half + (z.toFloat() / grid) * (half * 2f)
                val onRoad = kotlin.math.abs(wx) < 3.6f
                val r = if (onRoad) 0.98f else 0.72f
                val g = if (onRoad) 0.84f else 0.88f
                val b = if (onRoad) 0.62f else 0.52f
                v.add(wx); v.add(0f); v.add(wz); v.add(0f); v.add(1f); v.add(0f)
                v.add(x * 1.5f); v.add(z * 1.5f); v.add(r); v.add(g); v.add(b)
            }
        }
        val row = grid + 1
        for (z in 0 until grid) {
            for (x in 0 until grid) {
                val a = z * row + x; val b = a + row
                idx.add(a.toShort()); idx.add(b.toShort()); idx.add((a + 1).toShort())
                idx.add(b.toShort()); idx.add((b + 1).toShort()); idx.add((a + 1).toShort())
            }
        }
        val pair = uploadSimple(v.toFloatArray(), idx.toShortArray())
        groundVbo = pair.first; groundIbo = pair.second; groundCount = idx.size
    }

    private fun buildVilaDasAlmasStructures() {
        // Casas de taipa com telhado de barro + Poco central + Degraus (1 lote estatico!)
        val v = ArrayList<Float>(); val idx = ArrayList<Short>()
        fun addBox(cx: Float, cy: Float, cz: Float, sx: Float, sy: Float, sz: Float, r: Float, g: Float, b: Float) {
            val hx = sx * 0.5f; val hy = sy * 0.5f; val hz = sz * 0.5f
            val faces = arrayOf(
                floatArrayOf(0f,0f,1f, -hx,-hy,hz, hx,-hy,hz, hx,hy,hz, -hx,hy,hz),
                floatArrayOf(0f,0f,-1f, hx,-hy,-hz, -hx,-hy,-hz, -hx,hy,-hz, hx,hy,-hz),
                floatArrayOf(1f,0f,0f, hx,-hy,hz, hx,-hy,-hz, hx,hy,-hz, hx,hy,hz),
                floatArrayOf(-1f,0f,0f, -hx,-hy,-hz, -hx,-hy,hz, -hx,hy,hz, -hx,hy,-hz),
                floatArrayOf(0f,1f,0f, -hx,hy,hz, hx,hy,hz, hx,hy,-hz, -hx,hy,-hz)
            )
            for (f in faces) {
                val base = v.size / 11
                for (k in 0..3) {
                    v.add(cx + f[3 + k * 3]); v.add(cy + f[4 + k * 3]); v.add(cz + f[5 + k * 3])
                    v.add(f[0]); v.add(f[1]); v.add(f[2]); v.add(0.5f); v.add(0.5f); v.add(r); v.add(g); v.add(b)
                }
                idx.add(base.toShort()); idx.add((base + 1).toShort()); idx.add((base + 2).toShort())
                idx.add(base.toShort()); idx.add((base + 2).toShort()); idx.add((base + 3).toShort())
            }
        }
        // Casa 1 e Casa 2 da Vila das Almas
        addBox(-9f, 1.6f, -10f, 5.2f, 3.2f, 4.4f, 0.94f, 0.86f, 0.72f)
        addBox(-9f, 3.55f, -10f, 5.8f, 0.7f, 5.0f, 0.68f, 0.28f, 0.16f)
        addBox(9.5f, 1.6f, -14f, 5.6f, 3.2f, 4.6f, 0.92f, 0.84f, 0.70f)
        addBox(9.5f, 3.55f, -14f, 6.2f, 0.7f, 5.2f, 0.66f, 0.26f, 0.16f)
        // Poco central + Portal de entrada ao fundo
        addBox(0f, 0.55f, -12f, 2.0f, 1.1f, 2.0f, 0.65f, 0.62f, 0.58f)
        addBox(-1.9f, 2.2f, -20f, 0.55f, 4.4f, 0.55f, 0.45f, 0.24f, 0.14f)
        addBox(1.9f, 2.2f, -20f, 0.55f, 4.4f, 0.55f, 0.45f, 0.24f, 0.14f)
        addBox(0f, 4.2f, -20f, 5.2f, 0.5f, 0.65f, 0.58f, 0.22f, 0.14f)

        val pair = uploadSimple(v.toFloatArray(), idx.toShortArray())
        villageVbo = pair.first; villageIbo = pair.second; villageCount = idx.size
    }

    private fun buildShadowDisc() {
        val segs = 14
        val v = FloatArray((segs + 2) * 3)
        v[0] = 0f; v[1] = 0f; v[2] = 0f
        for (i in 0..segs) {
            val a = (i.toFloat() / segs) * 6.28318f
            v[(i + 1) * 3] = cos(a) * 0.55f
            v[(i + 1) * 3 + 1] = 0f
            v[(i + 1) * 3 + 2] = sin(a) * 0.55f
        }
        shadowCount = segs + 2
        val buf = ByteBuffer.allocateDirect(v.size * 4).order(ByteOrder.nativeOrder()).asFloatBuffer().apply { put(v); position(0) }
        val ids = IntArray(1)
        GLES20.glGenBuffers(1, ids, 0)
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, ids[0])
        GLES20.glBufferData(GLES20.GL_ARRAY_BUFFER, v.size * 4, buf, GLES20.GL_STATIC_DRAW)
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, 0)
        shadowVbo = ids[0]
    }

    private fun uploadSimple(v: FloatArray, i: ShortArray): Pair<Int, Int> {
        val vBuf = ByteBuffer.allocateDirect(v.size * 4).order(ByteOrder.nativeOrder()).asFloatBuffer().apply { put(v); position(0) }
        val iBuf = ByteBuffer.allocateDirect(i.size * 2).order(ByteOrder.nativeOrder()).asShortBuffer().apply { put(i); position(0) }
        val ids = IntArray(2)
        GLES20.glGenBuffers(2, ids, 0)
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, ids[0])
        GLES20.glBufferData(GLES20.GL_ARRAY_BUFFER, v.size * 4, vBuf, GLES20.GL_STATIC_DRAW)
        GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, ids[1])
        GLES20.glBufferData(GLES20.GL_ELEMENT_ARRAY_BUFFER, i.size * 2, iBuf, GLES20.GL_STATIC_DRAW)
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, 0)
        GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, 0)
        return ids[0] to ids[1]
    }
}
