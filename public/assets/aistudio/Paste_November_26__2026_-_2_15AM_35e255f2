### 2. Otimização de Texturas + Características de Personagens (`AnimeTextureAtlas.kt`)

Em vez de criar 15 texturas diferentes para herói, mestre, moradores e inimigos, você gera **1 único Atlas 512×512 (Power-of-Two)** no `onSurfaceCreated` com **4 quadrantes fixos** e reutiliza o mesmo Atlas para o jogo inteiro:
* **Quadrante Superior Esquerdo `(0..256, 0..256)`:** Rosto e Olhos Anime em camadas (íris colorida, pupila escura, dois brilhos brancos característicos de anime, sobrancelha marcada e versão "olho em brasa" para os Encantados da Sombra!).
* **Quadrante Superior Direito `(256..512, 0..256)`:** Dobras de roupa e couro (traços escuros pintados de camisa, gibão, fivela dourada e bandagens).
* **Quadrante Inferior Esquerdo `(0..256, 256..512)`:** Folhas de capim estilizadas com transparência (`Alpha`).
* **Quadrante Inferior Direito `(256..512, 256..512)`:** Rocha rachada e terra batida pintada à mão.

```kotlin
package com.cacadores.sertao.render

import android.graphics.*
import android.opengl.GLES20
import android.opengl.GLUtils

object AnimeTextureAtlas {

    fun createAndUploadAtlas512(): Int {
        val size = 512
        val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        val c = Canvas(bmp)
        c.drawColor(Color.TRANSPARENT)

        val p = Paint(Paint.ANTI_ALIAS_FLAG)

        // 1) QUADRANTE SUP. ESQ: Rosto + Olhos Anime (Herói em 0..128, Inimigo em 128..256)
        drawAnimeEyePair(c, p, offsetX = 0f, irisColor = Color.rgb(215, 130, 30), scleraColor = Color.rgb(248, 245, 240))
        drawAnimeEyePair(c, p, offsetX = 128f, irisColor = Color.rgb(255, 45, 30), scleraColor = Color.rgb(35, 22, 42))

        // 2) QUADRANTE SUP. DIR: Tecido / Gibao com dobras pintadas (256..512, 0..256)
        p.style = Paint.Style.FILL
        p.color = Color.rgb(225, 220, 212) // Base neutra para multiplicar por uShirtColor
        c.drawRect(256f, 0f, 512f, 256f, p)
        p.style = Paint.Style.STROKE
        p.strokeWidth = 4f
        p.color = Color.argb(95, 55, 38, 28) // Linhas de dobra estilo Naruto Storm
        for (row in 0..5) {
            val y = 32f + row * 38f
            c.drawLine(275f, y, 490f, y + 14f, p)
        }
        // Costura clara da barra do gibao
        p.color = Color.rgb(235, 195, 95)
        p.strokeWidth = 6f
        c.drawRect(262f, 6f, 506f, 250f, p)

        // 3) QUADRANTE INF. ESQ: Capim em laminas com alpha (0..256, 256..512)
        p.style = Paint.Style.FILL
        p.color = Color.WHITE // Cor real vem do aVertexColor (verde/dourado)
        val blades = floatArrayOf(0.18f, 0.34f, 0.50f, 0.67f, 0.84f)
        for ((idx, bx) in blades.withIndex()) {
            val baseX = bx * 256f
            val tipOffset = (idx - 2) * 18f
            val bladePath = Path().apply {
                moveTo(baseX - 18f, 510f)
                lineTo(baseX + tipOffset, 274f + (idx % 2) * 26f)
                lineTo(baseX + 18f, 510f)
                close()
            }
            c.drawPath(bladePath, p)
        }

        // 4) QUADRANTE INF. DIR: Rocha rachada estilo Storm (256..512, 256..512)
        p.color = Color.rgb(205, 192, 178)
        c.drawRect(256f, 256f, 512f, 512f, p)
        p.style = Paint.Style.STROKE
        p.strokeWidth = 3.5f
        p.color = Color.argb(110, 60, 45, 38)
        c.drawLine(270f, 290f, 360f, 355f, p)
        c.drawLine(360f, 355f, 330f, 440f, p)
        c.drawLine(360f, 355f, 470f, 390f, p)
        c.drawLine(410f, 265f, 455f, 340f, p)

        val texIds = IntArray(1)
        GLES20.glGenTextures(1, texIds, 0)
        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, texIds[0])
        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MIN_FILTER, GLES20.GL_LINEAR_MIPMAP_LINEAR)
        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_MAG_FILTER, GLES20.GL_LINEAR)
        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_WRAP_S, GLES20.GL_CLAMP_TO_EDGE)
        GLES20.glTexParameteri(GLES20.GL_TEXTURE_2D, GLES20.GL_TEXTURE_WRAP_T, GLES20.GL_CLAMP_TO_EDGE)

        GLUtils.texImage2D(GLES20.GL_TEXTURE_2D, 0, bmp, 0)
        GLES20.glGenerateMipmap(GLES20.GL_TEXTURE_2D)
        bmp.recycle()
        return texIds[0]
    }

    private fun drawAnimeEyePair(c: Canvas, p: Paint, offsetX: Float, irisColor: Int, scleraColor: Int) {
        p.style = Paint.Style.FILL
        p.color = Color.rgb(245, 212, 182) // Base pele neutra
        c.drawRect(offsetX, 0f, offsetX + 128f, 256f, p)

        for (eye in 0..1) {
            val ex = offsetX + if (eye == 0) 34f else 94f
            val ey = 120f
            p.color = scleraColor
            c.drawOval(ex - 16f, ey - 11f, ex + 16f, ey + 11f, p)
            p.color = irisColor
            c.drawCircle(ex, ey, 8.5f, p)
            p.color = Color.BLACK
            c.drawCircle(ex, ey, 4f, p)
            // Brilho anime caracteristico
            p.color = Color.WHITE
            c.drawCircle(ex - 3f, ey - 3f, 2.4f, p)
            // Cilios superiores grossos
            p.style = Paint.Style.STROKE
            p.strokeWidth = 4f
            p.color = Color.rgb(25, 18, 16)
            c.drawArc(ex - 17f, ey - 13f, ex + 17f, ey + 9f, 195f, 150f, false, p)
            p.style = Paint.Style.FILL
        }
    }
}
