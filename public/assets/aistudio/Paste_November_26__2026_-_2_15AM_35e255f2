### 4. `SertaoGLRenderer.kt` (O Motor 3D Completo Ligando Tudo)

Integra no seu `GLSurfaceView`: **Céu → Chão + Vila → Static Batching de Grama/Rochas → Sombras no Solo → Personagens Cel-Shaded → Contorno Anime (`GL_FRONT`) → Animação articulada (inclinação de corrida, braços/pernas, cachecol ao vento e golpe de espada) + Câmera de Diálogo estilo Foto 3**.

```kotlin
package com.cacadores.sertao.render

import android.opengl.GLES20
import android.opengl.GLSurfaceView
import android.opengl.Matrix
import javax.microedition.khronos.egl.EGLConfig
import javax.microedition.khronos.opengles.GL10
import kotlin.math.cos
import kotlin.math.sin

data class RenderActorState(
    val id: String,
    val x: Float, val y: Float, val z: Float,
    val yawDeg: Float,
    val speedRatio: Float, // 0f parado, 1f correndo
    val attackAnim: Float  // 0f..1f durante golpe
)

class SertaoGLRenderer : GLSurfaceView.Renderer {

    private val projMatrix = FloatArray(16)
    private val viewMatrix = FloatArray(16)
    private val modelMatrix = FloatArray(16)
    private val mvpMatrix = FloatArray(16)

    private var toonProg = 0
    private var outlineProg = 0
    private var unlitProg = 0
    private var atlasTexId = 0

    private val staticBatcher = StaticSceneBatcher()
    private val worldRenderer = WorldSkyAndGroundRenderer()
    private val actorMeshes = HashMap<String, HumanoidAnimeMesh>()

    @Volatile var actors: List<RenderActorState> = emptyList()
    @Volatile var isDialogueCamera: Boolean = false
    @Volatile var dialogueTargetPos: FloatArray = floatArrayOf(0f, 1.3f, -5f)
    @Volatile var camYawRad: Float = 0f
    @Volatile var camPitchRad: Float = 0.28f

    private var animTime = 0f

    override fun onSurfaceCreated(gl: GL10?, config: EGLConfig?) {
        GLES20.glEnable(GLES20.GL_DEPTH_TEST)
        GLES20.glEnable(GLES20.GL_CULL_FACE)
        GLES20.glCullFace(GLES20.GL_BACK)

        toonProg = createProgram(TOON_VERT, TOON_FRAG)
        outlineProg = createProgram(OUTLINE_VERT, OUTLINE_FRAG)
        unlitProg = createProgram(UNLIT_VERT, UNLIT_FRAG)

        atlasTexId = AnimeTextureAtlas.createAndUploadAtlas512()
        staticBatcher.buildStaticSertaoProps()
        worldRenderer.init()

        // Cria malhas base prontas (pode expandir dinamicamente por regiao)
        registerActor(SertaoCharacterCatalog.heroKauan(weaponTier = 2, armorTier = 2))
        registerActor(SertaoCharacterCatalog.MESTRE_SEVERINO)
        registerActor(SertaoCharacterCatalog.ESPREITADOR_COMUM)
    }

    fun registerActor(profile: CharacterVisualProfile) {
        actorMeshes[profile.id]?.release()
        val mesh = HumanoidAnimeMesh(profile)
        mesh.buildAndUpload()
        actorMeshes[profile.id] = mesh
    }

    override fun onSurfaceChanged(gl: GL10?, width: Int, height: Int) {
        GLES20.glViewport(0, 0, width, height)
        val ratio = width.toFloat() / height.coerceAtLeast(1)
        Matrix.perspectiveM(projMatrix, 0, 50f, ratio, 0.2f, 150f)
    }

    override fun onDrawFrame(gl: GL10?) {
        animTime += 0.016f
        GLES20.glClear(GLES20.GL_COLOR_BUFFER_BIT or GLES20.GL_DEPTH_BUFFER_BIT)

        val hero = actors.firstOrNull { it.id == "kauan" } ?: RenderActorState("kauan", 0f, 0f, 0f, 180f, 0f, 0f)
        val camPos = updateCamera(hero)

        // 1) Cupula de Ceu e Serras
        GLES20.glUseProgram(unlitProg)
        Matrix.setIdentityM(modelMatrix, 0)
        Matrix.translateM(modelMatrix, 0, camPos[0], 0f, camPos[2])
        multiplyMvp()
        worldRenderer.drawSky(
            mvpMatrix,
            GLES20.glGetAttribLocation(unlitProg, "aPosition"),
            GLES20.glGetAttribLocation(unlitProg, "aVertexColor"),
            GLES20.glGetUniformLocation(unlitProg, "uMVPMatrix")
        )

        // 2) Cenario Cel-Shaded + Static Batching
        GLES20.glUseProgram(toonProg)
        GLES20.glActiveTexture(GLES20.GL_TEXTURE0)
        GLES20.glUniform1i(GLES20.glGetUniformLocation(toonProg, "uTexture"), 0)
        GLES20.glUniform3f(GLES20.glGetUniformLocation(toonProg, "uSunDir"), 0.55f, 0.78f, 0.42f)
        GLES20.glUniform3f(GLES20.glGetUniformLocation(toonProg, "uCameraPos"), camPos[0], camPos[1], camPos[2])
        GLES20.glUniform4f(GLES20.glGetUniformLocation(toonProg, "uShadeTint"), 0.62f, 0.54f, 0.68f, 1f)
        GLES20.glUniform3f(GLES20.glGetUniformLocation(toonProg, "uRimColor"), 1.0f, 0.92f, 0.76f)

        Matrix.setIdentityM(modelMatrix, 0)
        multiplyMvp()
        GLES20.glUniformMatrix4fv(GLES20.glGetUniformLocation(toonProg, "uMVPMatrix"), 1, false, mvpMatrix, 0)
        GLES20.glUniformMatrix4fv(GLES20.glGetUniformLocation(toonProg, "uModelMatrix"), 1, false, modelMatrix, 0)
        GLES20.glUniform4f(GLES20.glGetUniformLocation(toonProg, "uBaseColor"), 1f, 1f, 1f, 1f)
        GLES20.glUniform1f(GLES20.glGetUniformLocation(toonProg, "uUseTexture"), 1f)
        GLES20.glUniform1f(GLES20.glGetUniformLocation(toonProg, "uAlphaCutoff"), 0.0f)
        GLES20.glUniform1f(GLES20.glGetUniformLocation(toonProg, "uEmissive"), 0.0f)
        GLES20.glUniform1f(GLES20.glGetUniformLocation(toonProg, "uRimStrength"), 0.0f)

        val pLoc = GLES20.glGetAttribLocation(toonProg, "aPosition")
        val nLoc = GLES20.glGetAttribLocation(toonProg, "aNormal")
        val uLoc = GLES20.glGetAttribLocation(toonProg, "aTexCoord")
        val cLoc = GLES20.glGetAttribLocation(toonProg, "aVertexColor")
        worldRenderer.drawGroundAndVillage(pLoc, nLoc, uLoc, cLoc)

        // Static Batching (Grama e Rochas com 1 unica ligacao de Atlas!)
        GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, atlasTexId)
        GLES20.glUniform1f(GLES20.glGetUniformLocation(toonProg, "uAlphaCutoff"), 0.45f)
        GLES20.glDisable(GLES20.GL_CULL_FACE) // Grama visivel dos dois lados
        staticBatcher.drawAll(pLoc, nLoc, uLoc, cLoc)
        GLES20.glEnable(GLES20.GL_CULL_FACE)

        // 3) Sombras Projetadas no Chao sob cada personagem
        GLES20.glEnable(GLES20.GL_BLEND)
        GLES20.glBlendFunc(GLES20.GL_SRC_ALPHA, GLES20.GL_ONE_MINUS_SRC_ALPHA)
        GLES20.glDepthMask(false)
        GLES20.glUseProgram(outlineProg)
        GLES20.glUniform4f(GLES20.glGetUniformLocation(outlineProg, "uOutlineColor"), 0.06f, 0.04f, 0.08f, 0.42f)
        GLES20.glUniform1f(GLES20.glGetUniformLocation(outlineProg, "uOutlineWidth"), 0.0f)
        for (actor in actors) {
            val mesh = actorMeshes[actor.id] ?: continue
            val jumpShrink = (1.0f - actor.y * 0.22f).coerceIn(0.45f, 1.0f) * mesh.profile.scale
            Matrix.setIdentityM(modelMatrix, 0)
            Matrix.translateM(modelMatrix, 0, actor.x, 0.03f, actor.z)
            Matrix.scaleM(modelMatrix, 0, jumpShrink, 1f, jumpShrink)
            multiplyMvp()
            GLES20.glUniformMatrix4fv(GLES20.glGetUniformLocation(outlineProg, "uMVPMatrix"), 1, false, mvpMatrix, 0)
            worldRenderer.drawContactShadow(GLES20.glGetAttribLocation(outlineProg, "aPosition"))
        }
        GLES20.glDepthMask(true)
        GLES20.glDisable(GLES20.GL_BLEND)

        // 4) Personagens: Passe 1 (Cel-Shading MToon) + Passe 2 (Contorno Anime GL_FRONT)
        for (actor in actors) {
            val mesh = actorMeshes[actor.id] ?: continue
            drawActorPass(actor, mesh, outlinePass = false, camPos = camPos)
            drawActorPass(actor, mesh, outlinePass = true, camPos = camPos)
        }
    }

    private fun drawActorPass(actor: RenderActorState, mesh: HumanoidAnimeMesh, outlinePass: Boolean, camPos: FloatArray) {
        val prog = if (outlinePass) outlineProg else toonProg
        GLES20.glUseProgram(prog)
        if (outlinePass) {
            GLES20.glCullFace(GLES20.GL_FRONT)
            val oc = mesh.profile.outlineColor
            GLES20.glUniform4f(GLES20.glGetUniformLocation(prog, "uOutlineColor"), oc[0], oc[1], oc[2], oc[3])
            GLES20.glUniform1f(GLES20.glGetUniformLocation(prog, "uOutlineWidth"), 0.012f)
        } else {
            GLES20.glCullFace(GLES20.GL_BACK)
            GLES20.glBindTexture(GLES20.GL_TEXTURE_2D, atlasTexId)
            GLES20.glUniform1f(GLES20.glGetUniformLocation(prog, "uAlphaCutoff"), 0.0f)
            GLES20.glUniform1f(GLES20.glGetUniformLocation(prog, "uRimStrength"), 0.42f)
        }

        val runSwing = sin(animTime * 10.5f) * 38f * actor.speedRatio
        val runLean = 14f * actor.speedRatio // Inclinacao anime ao correr (estilo Storm!)
        val slashAngle = sin(actor.attackAnim * 3.1415f) * 105f
        val sc = mesh.profile.scale

        for ((part, buf) in mesh.parts) {
            Matrix.setIdentityM(modelMatrix, 0)
            Matrix.translateM(modelMatrix, 0, actor.x, actor.y, actor.z)
            Matrix.rotateM(modelMatrix, 0, actor.yawDeg, 0f, 1f, 0f)
            Matrix.scaleM(modelMatrix, 0, sc, sc, sc)
            Matrix.translateM(modelMatrix, 0, 0f, 0.78f, 0f) // Altura do quadril
            Matrix.rotateM(modelMatrix, 0, runLean, 1f, 0f, 0f)

            when (part) {
                HumanoidAnimeMesh.BodyPart.TORSO -> {}
                HumanoidAnimeMesh.BodyPart.HEAD -> Matrix.translateM(modelMatrix, 0, 0f, 0.54f, 0f)
                HumanoidAnimeMesh.BodyPart.LEFT_ARM -> {
                    Matrix.translateM(modelMatrix, 0, -0.27f * mesh.profile.shoulderWidthScale, 0.48f, 0f)
                    Matrix.rotateM(modelMatrix, 0, runSwing, 1f, 0f, 0f)
                }
                HumanoidAnimeMesh.BodyPart.RIGHT_ARM -> {
                    Matrix.translateM(modelMatrix, 0, 0.27f * mesh.profile.shoulderWidthScale, 0.48f, 0f)
                    Matrix.rotateM(modelMatrix, 0, -runSwing - slashAngle, 1f, 0f, 0f)
                }
                HumanoidAnimeMesh.BodyPart.WEAPON -> {
                    Matrix.translateM(modelMatrix, 0, 0.27f * mesh.profile.shoulderWidthScale, 0.48f, 0f)
                    Matrix.rotateM(modelMatrix, 0, -runSwing - slashAngle, 1f, 0f, 0f)
                    Matrix.translateM(modelMatrix, 0, 0f, -0.54f * mesh.profile.armLengthScale, 0.04f)
                }
                HumanoidAnimeMesh.BodyPart.LEFT_LEG -> Matrix.rotateM(modelMatrix, 0, -runSwing * 0.9f, 1f, 0f, 0f)
                HumanoidAnimeMesh.BodyPart.RIGHT_LEG -> Matrix.rotateM(modelMatrix, 0, runSwing * 0.9f, 1f, 0f, 0f)
                HumanoidAnimeMesh.BodyPart.BACK_CLOTH -> {
                    Matrix.translateM(modelMatrix, 0, 0f, 0.48f, -0.02f)
                    val flutter = 10f + actor.speedRatio * 28f + sin(animTime * 6f) * 8f
                    Matrix.rotateM(modelMatrix, 0, flutter, 1f, 0f, 0f)
                }
            }

            multiplyMvp()
            GLES20.glUniformMatrix4fv(GLES20.glGetUniformLocation(prog, "uMVPMatrix"), 1, false, mvpMatrix, 0)
            if (!outlinePass) {
                GLES20.glUniformMatrix4fv(GLES20.glGetUniformLocation(prog, "uModelMatrix"), 1, false, modelMatrix, 0)
                GLES20.glUniform4fv(GLES20.glGetUniformLocation(prog, "uBaseColor"), 1, buf.tintColor, 0)
                GLES20.glUniform1f(GLES20.glGetUniformLocation(prog, "uUseTexture"), buf.useTexture)
                GLES20.glUniform1f(GLES20.glGetUniformLocation(prog, "uEmissive"), buf.emissive)
            }

            GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, buf.vboId)
            GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, buf.iboId)

            val stride = HumanoidAnimeMesh.STRIDE_BYTES
            val posLoc = GLES20.glGetAttribLocation(prog, "aPosition")
            GLES20.glEnableVertexAttribArray(posLoc)
            GLES20.glVertexAttribPointer(posLoc, 3, GLES20.GL_FLOAT, false, stride, 0)

            if (outlinePass) {
                val snLoc = GLES20.glGetAttribLocation(prog, "aSmoothNormal")
                GLES20.glEnableVertexAttribArray(snLoc)
                GLES20.glVertexAttribPointer(snLoc, 3, GLES20.GL_FLOAT, false, stride, 44)
            } else {
                val normLoc = GLES20.glGetAttribLocation(prog, "aNormal")
                val uvLoc = GLES20.glGetAttribLocation(prog, "aTexCoord")
                val colLoc = GLES20.glGetAttribLocation(prog, "aVertexColor")
                GLES20.glEnableVertexAttribArray(normLoc); GLES20.glVertexAttribPointer(normLoc, 3, GLES20.GL_FLOAT, false, stride, 12)
                GLES20.glEnableVertexAttribArray(uvLoc);   GLES20.glVertexAttribPointer(uvLoc, 2, GLES20.GL_FLOAT, false, stride, 24)
                GLES20.glEnableVertexAttribArray(colLoc);  GLES20.glVertexAttribPointer(colLoc, 3, GLES20.GL_FLOAT, false, stride, 32)
            }
            GLES20.glDrawElements(GLES20.GL_TRIANGLES, buf.indexCount, GLES20.GL_UNSIGNED_SHORT, 0)
        }
        GLES20.glCullFace(GLES20.GL_BACK)
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, 0)
        GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, 0)
    }

    private fun updateCamera(hero: RenderActorState): FloatArray {
        val camPos = FloatArray(3)
        if (isDialogueCamera) {
            // Enquadramento cinematografico de dialogo frente a frente (estilo Foto 3)
            camPos[0] = hero.x + 1.8f
            camPos[1] = hero.y + 1.65f
            camPos[2] = hero.z + 2.4f
            Matrix.setLookAtM(viewMatrix, 0, camPos[0], camPos[1], camPos[2], dialogueTargetPos[0], dialogueTargetPos[1], dialogueTargetPos[2], 0f, 1f, 0f)
        } else {
            val dist = 5.4f
            camPos[0] = hero.x + sin(camYawRad) * cos(camPitchRad) * dist
            camPos[1] = hero.y + 1.55f + sin(camPitchRad) * dist
            camPos[2] = hero.z + cos(camYawRad) * cos(camPitchRad) * dist
            Matrix.setLookAtM(viewMatrix, 0, camPos[0], camPos[1], camPos[2], hero.x, hero.y + 1.35f, hero.z, 0f, 1f, 0f)
        }
        return camPos
    }

    private fun multiplyMvp() {
        val vm = FloatArray(16)
        Matrix.multiplyMM(vm, 0, viewMatrix, 0, modelMatrix, 0)
        Matrix.multiplyMM(mvpMatrix, 0, projMatrix, 0, vm, 0)
    }

    private fun createProgram(vs: String, fs: String): Int {
        val v = loadShader(GLES20.GL_VERTEX_SHADER, vs)
        val f = loadShader(GLES20.GL_FRAGMENT_SHADER, fs)
        return GLES20.glCreateProgram().also {
            GLES20.glAttachShader(it, v)
            GLES20.glAttachShader(it, f)
            GLES20.glLinkProgram(it)
        }
    }

    private fun loadShader(type: Int, src: String): Int =
        GLES20.glCreateShader(type).also {
            GLES20.glShaderSource(it, src)
            GLES20.glCompileShader(it)
        }

    companion object {
        private const val TOON_VERT = """
            uniform mat4 uMVPMatrix; uniform mat4 uModelMatrix;
            attribute vec3 aPosition; attribute vec3 aNormal; attribute vec2 aTexCoord; attribute vec3 aVertexColor;
            varying vec3 vWorldPos; varying vec3 vNormal; varying vec2 vUv; varying vec3 vCol;
            void main() {
                vec4 wp = uModelMatrix * vec4(aPosition, 1.0);
                vWorldPos = wp.xyz;
                vNormal = normalize(mat3(uModelMatrix) * aNormal);
                vUv = aTexCoord; vCol = aVertexColor;
                gl_Position = uMVPMatrix * vec4(aPosition, 1.0);
            }
        """
        private const val TOON_FRAG = """
            precision mediump float;
            uniform sampler2D uTexture; uniform vec4 uBaseColor; uniform vec4 uShadeTint;
            uniform vec3 uSunDir; uniform vec3 uCameraPos; uniform vec3 uRimColor;
            uniform float uRimStrength; uniform float uUseTexture; uniform float uAlphaCutoff; uniform float uEmissive;
            varying vec3 vWorldPos; varying vec3 vNormal; varying vec2 vUv; varying vec3 vCol;
            void main() {
                vec4 tex = mix(vec4(1.0), texture2D(uTexture, vUv), uUseTexture);
                if (uAlphaCutoff > 0.0 && tex.a < uAlphaCutoff) discard;
                vec3 N = normalize(vNormal); vec3 L = normalize(uSunDir); vec3 V = normalize(uCameraPos - vWorldPos);
                vec3 albedo = tex.rgb * uBaseColor.rgb * vCol;
                float ndotl = dot(N, L);
                float band = smoothstep(0.02, 0.09, ndotl);
                vec3 lit = mix(albedo * uShadeTint.rgb, albedo * 1.08, band);
                float rim = pow(1.0 - clamp(dot(N, V), 0.0, 1.0), 3.0) * smoothstep(0.0, 0.4, ndotl + 0.35);
                // Neblina azulada de profundidade igual as fotos 2 e 3
                float dist = length(uCameraPos - vWorldPos);
                float fog = clamp((dist - 22.0) / 55.0, 0.0, 0.72);
                vec3 col = lit + uRimColor * rim * uRimStrength + albedo * uEmissive;
                gl_FragColor = vec4(mix(col, vec3(0.62, 0.78, 0.92), fog), 1.0);
            }
        """
        private const val OUTLINE_VERT = """
            uniform mat4 uMVPMatrix; uniform float uOutlineWidth;
            attribute vec3 aPosition; attribute vec3 aSmoothNormal;
            void main() {
                vec4 cp = uMVPMatrix * vec4(aPosition, 1.0);
                float s = clamp(cp.w * 0.14, 0.6, 2.2);
                gl_Position = uMVPMatrix * vec4(aPosition + normalize(aSmoothNormal) * (uOutlineWidth * s), 1.0);
            }
        """
        private const val OUTLINE_FRAG = """
            precision mediump float; uniform vec4 uOutlineColor;
            void main() { gl_FragColor = uOutlineColor; }
        """
        private const val UNLIT_VERT = """
            uniform mat4 uMVPMatrix; attribute vec3 aPosition; attribute vec3 aVertexColor;
            varying vec3 vCol;
            void main() { vCol = aVertexColor; gl_Position = uMVPMatrix * vec4(aPosition, 1.0); }
        """
        private const val UNLIT_FRAG = """
            precision mediump float; varying vec3 vCol;
            void main() { gl_FragColor = vec4(vCol, 1.0); }
        """
    }
}
