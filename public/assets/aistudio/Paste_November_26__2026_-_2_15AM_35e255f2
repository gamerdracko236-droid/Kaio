@Composable
fun StormVirtualJoystick(
    onMove: (x: Float, y: Float) -> Unit,
    modifier: Modifier = Modifier
) {
    val maxRadius = 56f
    var knobOffset by remember { mutableStateOf(Offset.Zero) }

    Box(
        modifier = modifier
            .size(132.dp)
            .clip(CircleShape)
            .background(Color(0x5518120E))
            .border(BorderStroke(2.dp, GoldBrush), CircleShape)
            .pointerInput(Unit) {
                detectDragGestures(
                    onDragEnd = {
                        knobOffset = Offset.Zero
                        onMove(0f, 0f)
                    },
                    onDragCancel = {
                        knobOffset = Offset.Zero
                        onMove(0f, 0f)
                    },
                    onDrag = { change, dragAmount ->
                        change.consume()
                        val next = knobOffset + dragAmount
                        val dist = sqrt(next.x * next.x + next.y * next.y)
                        knobOffset = if (dist > maxRadius) next * (maxRadius / dist) else next
                        onMove(knobOffset.x / maxRadius, knobOffset.y / maxRadius)
                    }
                )
            },
        contentAlignment = Alignment.Center
    ) {
        Box(
            modifier = Modifier
                .offset { IntOffset(knobOffset.x.roundToInt(), knobOffset.y.roundToInt()) }
                .size(52.dp)
                .clip(CircleShape)
                .background(Color(0xCC3B2618))
                .border(BorderStroke(2.dp, Color(0xFFFFD54F)), CircleShape)
        )
    }
}

