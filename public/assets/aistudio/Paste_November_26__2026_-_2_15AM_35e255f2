### 1. Static Batching no `onSurfaceCreated` (`StaticSceneBatcher.kt`)

No OpenGL ES 2.0, desenhar 400 tufos de capim e 80 pedras com chamadas separadas derruba o FPS no celular. Este *batcher* junta tudo em **1 VBO + 1 IBO por lote** (dividindo automaticamente se passar de 60.000 vértices, porque GLES 2.0 padrão só garante índices `Short`).

Além disso, ele grava **cor por vértice (`aVertexColor`)**: a base da grama e das pedras fica mais escura (simulação de *Ambient Occlusion* de contato com o chão) e as pontas ficam mais claras ao sol — exatamente o truque visual usado nos cenários do *Storm*.

```kotlin
package com.cacadores.sertao.render

import android.opengl.GLES20
import java.nio.ByteBuffer
import java.nio.ByteOrder
import kotlin.math.cos
import kotlin.math.sin
import kotlin.random.Random

/**
 * Formato de vertice intercalado (11 floats = 44 bytes):
 * pos(3) + normal(3) + uv(2) + vertexColor(3)
 */
class StaticSceneBatcher {

    companion object {
        const val FLOATS_PER_VERTEX = 11
        const val STRIDE_BYTES = FLOATS_PER_VERTEX * 4
        private const val MAX_VERTICES_PER_BATCH = 60_000
    }

    private data class GpuBatch(val vboId: Int, val iboId: Int, val indexCount: Int)

    private val vertexBuilder = ArrayList<Float>(16_384)
    private val indexBuilder = ArrayList<Short>(16_384)
    private val gpuBatches = ArrayList<GpuBatch>()
    private var currentVertexCount = 0

    /**
     * Chame dentro de GLSurfaceView.Renderer.onSurfaceCreated()
     */
    fun buildStaticSertaoProps(seed: Int = 42) {
        release()
        val rng = Random(seed)

        // 1) Lote de Grama Estilizada (350 tufos em X cruzado nas bordas da trilha)
        for (i in 0 until 350) {
            val angle = rng.nextFloat() * 6.2831f
            val dist = 3.2f + rng.nextFloat() * 32.0f
            val gx = cos(angle) * dist
            val gz = sin(angle) * dist
            // Deixa o centro da trilha de terra livre
            if (kotlin.math.abs(gx) < 2.2f && gz in -25f..25f) continue

            val scale = 0.55f + rng.nextFloat() * 0.65f
            val rotY = rng.nextFloat() * 3.1415f
            val dryMix = rng.nextFloat()
            val tipR = 0.48f + dryMix * 0.35f // Mistura verde vivo com capim dourado do sertao
            val tipG = 0.78f - dryMix * 0.12f
            val tipB = 0.22f
            addCrossedGrassTuft(gx, 0.0f, gz, scale, rotY, tipR, tipG, tipB)
        }

        // 2) Lote de Rochas e Lajedos Estilizados (65 pedras)
        for (i in 0 until 65) {
            val rx = (rng.nextFloat() - 0.5f) * 68f
            val rz = (rng.nextFloat() - 0.5f) * 68f
            if (kotlin.math.abs(rx) < 3.0f && kotlin.math.abs(rz) < 12.0f) continue
            val sx = 0.7f + rng.nextFloat() * 1.9f
            val sy = 0.45f + rng.nextFloat() * 1.2f
            val sz = 0.7f + rng.nextFloat() * 1.7f
            addStylizedRock(rx, sy * 0.35f, rz, sx, sy, sz, rng.nextFloat() * 6.28f)
        }

        flushBatchToGpu()
    }

    private fun addCrossedGrassTuft(
        x: Float, y: Float, z: Float,
        scale: Float, rotY: Float,
        tipR: Float, tipG: Float, tipB: Float
    ) {
        ensureCapacity(8)
        val halfW = 0.36f * scale
        val height = 0.62f * scale
        val rootR = tipR * 0.38f
        val rootG = tipG * 0.45f
        val rootB = tipB * 0.38f

        // 2 planos cruzados em 60 graus para volume 3D de qualquer angulo
        for (plane in 0..1) {
            val a = rotY + plane * 1.0472f
            val dx = cos(a) * halfW
            val dz = sin(a) * halfW
            val baseIdx = currentVertexCount

            // Regiao UV do capim no Atlas (quadrante inferior esquerdo: u 0.0..0.5, v 0.5..1.0)
            pushVertex(x - dx, y, z - dz, 0f, 1f, 0f, 0.02f, 0.98f, rootR, rootG, rootB)
            pushVertex(x + dx, y, z + dz, 0f, 1f, 0f, 0.48f, 0.98f, rootR, rootG, rootB)
            pushVertex(x + dx * 1.15f, y + height, z + dz * 1.15f, 0f, 1f, 0f, 0.48f, 0.52f, tipR, tipG, tipB)
            pushVertex(x - dx * 1.15f, y + height, z - dz * 1.15f, 0f, 1f, 0f, 0.02f, 0.52f, tipR, tipG, tipB)

            pushTriangle(baseIdx, baseIdx + 1, baseIdx + 2)
            pushTriangle(baseIdx, baseIdx + 2, baseIdx + 3)
        }
    }

    private fun addStylizedRock(
        cx: Float, cy: Float, cz: Float,
        sx: Float, sy: Float, sz: Float, rotY: Float
    ) {
        // Prisma octogonal chanfrado (10 vertices, visual lapidado de anime)
        ensureCapacity(24)
        val c = cos(rotY)
        val s = sin(rotY)

        fun rot(px: Float, py: Float, pz: Float): FloatArray {
            val wx = cx + (px * sx * c - pz * sz * s)
            val wz = cz + (px * sx * s + pz * sz * c)
            val wy = cy + py * sy
            return floatArrayOf(wx, wy, wz)
        }

        val sides = 6
        val topCenter = rot(0.08f, 0.55f, -0.05f)
        val baseRing = Array(sides) { i ->
            val a = i * (6.28318f / sides)
            val jitter = if (i % 2 == 0) 0.52f else 0.42f
            rot(cos(a) * jitter, -0.35f, sin(a) * jitter)
        }
        val midRing = Array(sides) { i ->
            val a = i * (6.28318f / sides) + 0.18f
            val jitter = if (i % 2 == 0) 0.36f else 0.44f
            rot(cos(a) * jitter, 0.25f, sin(a) * jitter)
        }

        // Laterais e topo facetados com sombra de base mais escura
        for (i in 0 until sides) {
            val next = (i + 1) % sides
            val b0 = baseRing[i]; val b1 = baseRing[next]
            val m0 = midRing[i];  val m1 = midRing[next]
            val nx = cos(i * (6.28318f / sides) + rotY)
            val nz = sin(i * (6.28318f / sides) + rotY)

            val idx = currentVertexCount
            // UV da regiao de pedra no Atlas (u 0.52..0.98, v 0.52..0.98)
            pushVertex(b0[0], b0[1], b0[2], nx, 0.25f, nz, 0.54f, 0.96f, 0.45f, 0.40f, 0.38f)
            pushVertex(b1[0], b1[1], b1[2], nx, 0.25f, nz, 0.96f, 0.96f, 0.45f, 0.40f, 0.38f)
            pushVertex(m1[0], m1[1], m1[2], nx, 0.55f, nz, 0.96f, 0.54f, 0.72f, 0.65f, 0.58f)
            pushVertex(m0[0], m0[1], m0[2], nx, 0.55f, nz, 0.54f, 0.54f, 0.72f, 0.65f, 0.58f)
            pushTriangle(idx, idx + 1, idx + 2)
            pushTriangle(idx, idx + 2, idx + 3)

            val topIdx = currentVertexCount
            pushVertex(m0[0], m0[1], m0[2], 0f, 1f, 0f, 0.54f, 0.75f, 0.78f, 0.70f, 0.62f)
            pushVertex(m1[0], m1[1], m1[2], 0f, 1f, 0f, 0.94f, 0.75f, 0.78f, 0.70f, 0.62f)
            pushVertex(topCenter[0], topCenter[1], topCenter[2], 0f, 1f, 0f, 0.74f, 0.54f, 0.88f, 0.80f, 0.72f)
            pushTriangle(topIdx, topIdx + 1, topIdx + 2)
        }
    }

    private fun ensureCapacity(incomingVertices: Int) {
        if (currentVertexCount + incomingVertices >= MAX_VERTICES_PER_BATCH) {
            flushBatchToGpu()
        }
    }

    private fun pushVertex(
        x: Float, y: Float, z: Float,
        nx: Float, ny: Float, nz: Float,
        u: Float, v: Float,
        r: Float, g: Float, b: Float
    ) {
        vertexBuilder.add(x); vertexBuilder.add(y); vertexBuilder.add(z)
        vertexBuilder.add(nx); vertexBuilder.add(ny); vertexBuilder.add(nz)
        vertexBuilder.add(u); vertexBuilder.add(v)
        vertexBuilder.add(r); vertexBuilder.add(g); vertexBuilder.add(b)
        currentVertexCount++
    }

    private fun pushTriangle(a: Int, b: Int, c: Int) {
        indexBuilder.add(a.toShort())
        indexBuilder.add(b.toShort())
        indexBuilder.add(c.toShort())
    }

    private fun flushBatchToGpu() {
        if (indexBuilder.isEmpty()) return

        val vFloatArr = vertexBuilder.toFloatArray()
        val vBuf = ByteBuffer.allocateDirect(vFloatArr.size * 4)
            .order(ByteOrder.nativeOrder()).asFloatBuffer().apply {
                put(vFloatArr); position(0)
            }

        val iShortArr = indexBuilder.toShortArray()
        val iBuf = ByteBuffer.allocateDirect(iShortArr.size * 2)
            .order(ByteOrder.nativeOrder()).asShortBuffer().apply {
                put(iShortArr); position(0)
            }

        val ids = IntArray(2)
        GLES20.glGenBuffers(2, ids, 0)

        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, ids[0])
        GLES20.glBufferData(GLES20.GL_ARRAY_BUFFER, vFloatArr.size * 4, vBuf, GLES20.GL_STATIC_DRAW)

        GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, ids[1])
        GLES20.glBufferData(GLES20.GL_ELEMENT_ARRAY_BUFFER, iShortArr.size * 2, iBuf, GLES20.GL_STATIC_DRAW)

        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, 0)
        GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, 0)

        gpuBatches.add(GpuBatch(ids[0], ids[1], iShortArr.size))
        vertexBuilder.clear()
        indexBuilder.clear()
        currentVertexCount = 0
    }

    /**
     * Chame em onDrawFrame() com 1 unica ligacao de textura (Atlas)
     */
    fun drawAll(posLoc: Int, normLoc: Int, uvLoc: Int, colorLoc: Int) {
        for (batch in gpuBatches) {
            GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, batch.vboId)
            GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, batch.iboId)

            GLES20.glEnableVertexAttribArray(posLoc)
            GLES20.glVertexAttribPointer(posLoc, 3, GLES20.GL_FLOAT, false, STRIDE_BYTES, 0)

            GLES20.glEnableVertexAttribArray(normLoc)
            GLES20.glVertexAttribPointer(normLoc, 3, GLES20.GL_FLOAT, false, STRIDE_BYTES, 12)

            GLES20.glEnableVertexAttribArray(uvLoc)
            GLES20.glVertexAttribPointer(uvLoc, 2, GLES20.GL_FLOAT, false, STRIDE_BYTES, 24)

            GLES20.glEnableVertexAttribArray(colorLoc)
            GLES20.glVertexAttribPointer(colorLoc, 3, GLES20.GL_FLOAT, false, STRIDE_BYTES, 32)

            GLES20.glDrawElements(GLES20.GL_TRIANGLES, batch.indexCount, GLES20.GL_UNSIGNED_SHORT, 0)
        }
        GLES20.glBindBuffer(GLES20.GL_ARRAY_BUFFER, 0)
        GLES20.glBindBuffer(GLES20.GL_ELEMENT_ARRAY_BUFFER, 0)
    }

    fun release() {
        if (gpuBatches.isNotEmpty()) {
            val ids = IntArray(gpuBatches.size * 2)
            gpuBatches.forEachIndexed { idx, b ->
                ids[idx * 2] = b.vboId
                ids[idx * 2 + 1] = b.iboId
            }
            GLES20.glDeleteBuffers(ids.size, ids, 0)
            gpuBatches.clear()
        }
        vertexBuilder.clear()
        indexBuilder.clear()
        currentVertexCount = 0
    }
}
```
> **Dica no shader de cenário:** para o capim usar recorte transparente da folha no Atlas sem custo de *Alpha Blending*, coloque no fragment shader do cenário: `if (tex.a < 0.45) discard;` *(Alpha Cutout — 100% ordenado e rápido no Android!)*.

