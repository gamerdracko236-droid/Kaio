### Célula 3 — Gerar `.obj` + Textura `.png` (512×512) + Reduzir Polígonos para Android
*(Aqui já sai leve para celular e com os nomes certinhos `nome.obj` e `nome.png` pronto para jogar em `app/src/main/assets/models/`!)*

```python
import glob, os, shutil, subprocess
import pymeshlab

input_imgs = sorted(glob.glob("/content/input_images/*.*"))
out_raw = "/content/output_raw"
out_android = "/content/android_models"
os.makedirs(out_raw, exist_ok=True)
os.makedirs(out_android, exist_ok=True)

# 1) Gera 3D + textura assada (512x512 ideal para GLES 2.0)
cmd = [
    "python", "/content/TripoSR/run.py",
    *input_imgs,
    "--output-dir", out_raw,
    "--bake-texture",
    "--texture-resolution", "512",
    "--mc-resolution", "256"
]
subprocess.run(cmd, check=True)

# 2) Otimiza para celular (~6.000 faces) mantendo UVs e renomeia para <nome>.obj + <nome>.png
for idx, img_path in enumerate(input_imgs):
    base_name = os.path.splitext(os.path.basename(img_path))[0].lower().replace(" ", "_")
    sub_dir = os.path.join(out_raw, str(idx))
    raw_obj = os.path.join(sub_dir, "mesh.obj")
    raw_tex = os.path.join(sub_dir, "texture.png")

    dest_obj = os.path.join(out_android, f"{base_name}.obj")
    dest_png = os.path.join(out_android, f"{base_name}.png")

    if os.path.exists(raw_tex):
        shutil.copyfile(raw_tex, dest_png)

    if os.path.exists(raw_obj):
        ms = pymeshlab.MeshSet()
        ms.load_new_mesh(raw_obj)
        # Reduz para 6000 triangulos preservando costura de textura UV
        ms.meshing_decimation_quadric_edge_collapse_with_texture(
            targetfacenum=6000,
            preserveboundary=True,
            preservenormal=True
        )
        ms.save_current_mesh(dest_obj, save_vertex_color=False, save_wedge_texcoord=True, save_wedge_normal=True)
        print(f"Pronto para Android: {dest_obj} + {dest_png}")
```

